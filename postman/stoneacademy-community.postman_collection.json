{
  "info": {
    "_postman_id": "9a65e4aa-b890-44b1-91cb-b5cf6b5dd221",
    "name": "StoneAcademy Community API",
    "description": "Community mobile/frontend integration collection with single like toggle, reporting, edit/delete, activity attachments, and comment/reply attachments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "postId",
      "value": "6890e4caa12f9d001f1b0001"
    },
    {
      "key": "commentId",
      "value": "6890e4caa12f9d001f1b0301"
    },
    {
      "key": "eventId",
      "value": "6890e4caa12f9d001f1b0401"
    },
    {
      "key": "activityId",
      "value": "6890e4caa12f9d001f1b0501"
    },
    {
      "key": "mediaId",
      "value": "6890e4caa12f9d001f1b0201"
    }
  ],
  "item": [
    {
      "name": "Community Feed",
      "item": [
        {
          "name": "List Community Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/community/posts?page=1&limit=10&q=training",
            "description": "Lists non-deleted community posts sorted by createdAt descending."
          },
          "response": []
        },
        {
          "name": "Get Community Post Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/community/posts/{{postId}}",
            "description": "Fetches one non-deleted community post."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Community Management",
      "item": [
        {
          "name": "Toggle Community Post Like",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/community/posts/{{postId}}/like",
            "description": "Toggles the authenticated user's like state and returns the authoritative like count."
          },
          "response": []
        },
        {
          "name": "Edit Community Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Updated community post\",\n  \"mediaIds\": [\"{{mediaId}}\"],\n  \"activityId\": \"{{activityId}}\",\n  \"eventId\": null,\n  \"link\": \"https://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/posts/{{postId}}",
            "description": "Author-only post edit. Omitted fields are preserved; null clears nullable fields."
          },
          "response": []
        },
        {
          "name": "Delete Community Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/community/posts/{{postId}}",
            "description": "Author-only soft delete. Likes and comments are removed; media and reports are retained."
          },
          "response": []
        },
        {
          "name": "Report Community Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"spam\",\n  \"details\": \"Repeated promotional content\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/posts/{{postId}}/report",
            "description": "Reports a non-deleted community post through the existing Report module."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Community Comments",
      "item": [
        {
          "name": "List Post Comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/community/posts/{{postId}}/comments?page=1&limit=10",
            "description": "Lists top-level comments for a non-deleted post."
          },
          "response": []
        },
        {
          "name": "Create Post Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Great update\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/posts/{{postId}}/comments",
            "description": "Creates a text-only top-level comment."
          },
          "response": []
        },
        {
          "name": "Create Comment With Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Join my event\",\n  \"eventId\": \"{{eventId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/posts/{{postId}}/comments",
            "description": "Creates a comment with one of the authenticated user's Events."
          },
          "response": []
        },
        {
          "name": "Create Comment With Activity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": \"{{activityId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/posts/{{postId}}/comments",
            "description": "Creates a comment with one of the authenticated user's Activities."
          },
          "response": []
        },
        {
          "name": "List Comment Replies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/community/comments/{{commentId}}/replies?page=1&limit=10",
            "description": "Lists replies for a top-level comment."
          },
          "response": []
        },
        {
          "name": "Create Reply With Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Here is my event\",\n  \"eventId\": \"{{eventId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/comments/{{commentId}}/replies",
            "description": "Creates a reply with one of the authenticated user's Events."
          },
          "response": []
        },
        {
          "name": "Create Reply With Activity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityId\": \"{{activityId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/community/comments/{{commentId}}/replies",
            "description": "Creates a reply with one of the authenticated user's Activities."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Community Creator",
      "item": [
        {
          "name": "Create Community Post",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "text",
                  "value": "Morning training update",
                  "type": "text"
                },
                {
                  "key": "mediaIds",
                  "value": "[\"{{mediaId}}\"]",
                  "type": "text"
                },
                {
                  "key": "location[label]",
                  "value": "Central Park",
                  "type": "text"
                },
                {
                  "key": "location[latitude]",
                  "value": "40.785091",
                  "type": "text"
                },
                {
                  "key": "location[longitude]",
                  "value": "-73.968285",
                  "type": "text"
                },
                {
                  "key": "eventId",
                  "value": "{{eventId}}",
                  "type": "text"
                },
                {
                  "key": "link",
                  "value": "https://example.com",
                  "type": "text"
                },
                {
                  "key": "media",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/community-creator/posts",
            "description": "Creates a community post. Use either eventId or activityId, not both."
          },
          "response": []
        },
        {
          "name": "Create Post With Activity",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "text",
                  "value": "Try this activity",
                  "type": "text"
                },
                {
                  "key": "activityId",
                  "value": "{{activityId}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/community-creator/posts",
            "description": "Creates a community post with one of the authenticated user's Activities."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Selection APIs",
      "item": [
        {
          "name": "My Hosted Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/me/hosted/events?page=1&limit=10",
            "description": "Use this to select one of my Events for a post, comment, or reply."
          },
          "response": []
        },
        {
          "name": "My Hosted Activities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/me/hosted/activities?page=1&limit=10",
            "description": "Use this to select one of my Activities for a post, comment, or reply."
          },
          "response": []
        }
      ]
    }
  ]
}
